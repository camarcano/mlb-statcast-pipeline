# Season to project
HRPROJ_SEASON=2026

# Statcast pitch database written by mlb-statcast-pipeline.
# Defaults to the pipeline's own SAVANT_DB_PATH when unset.
HRPROJ_STATCAST_DB=/path/to/mlb-statcast-pipeline/data/savant.db

# Local cache (remaining schedule). Never the Statcast DB - this file is written to.
HRPROJ_CACHE_DB=data/hrproj.db

# Where project/backtest output files are written
HRPROJ_OUT_DIR=out
