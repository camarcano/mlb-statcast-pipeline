# Database path (absolute or relative to project root)
SAVANT_DB_PATH=data/savant.db

# Logging
SAVANT_LOG_DIR=logs
SAVANT_LOG_LEVEL=INFO

# API settings
SAVANT_RATE_LIMIT=1.5
SAVANT_MAX_RETRIES=3
SAVANT_REQUEST_TIMEOUT=120

# GitHub (for deployment scripts)
GH_PAT=ghp_your_token_here
GH_USERNAME=your_username_here
